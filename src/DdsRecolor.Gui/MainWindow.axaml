<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DdsRecolor.Gui"
        x:Class="DdsRecolor.Gui.MainWindow"
        Title="DDS Recolor"
        Width="1480" Height="960"
        MinWidth="1050" MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Background="#202B29" Padding="18,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="DDS RECOLOR" FontSize="18" FontWeight="Bold" Foreground="#F2F2EC" />
                    <TextBlock x:Name="FolderPathText" Text="Open a folder or a DDS file" FontSize="12" Foreground="#AAB8B2" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open folder" Margin="0,0,8,0" Padding="18,8" Click="OpenFolderClicked" />
                <Button Grid.Column="2" Content="Open DDS" Padding="18,8" Click="OpenFileClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,12">
                        <TextBlock Text="TEXTURES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FileCountText" Grid.Column="1" Text="0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                    <ListBox x:Name="FileListBox" Grid.Row="1" SelectionChanged="FileSelectionChanged" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:TextureEntry">
                                <Border Padding="9,8" Margin="0,0,0,4" Background="{DynamicResource ListItemBackgroundBrush}" CornerRadius="3">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="16,12,16,12">
                <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="PreviewTitle" Text="No texture selected" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock x:Name="PreviewDetails" Text="BC1, BC2 and BC3 previews are supported" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" BorderBrush="#C6CCC4" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <Grid Background="#272D2A">
                        <local:CheckerboardSurface IsHitTestVisible="False" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" Cursor="Hand"
                               PointerPressed="PreviewPressed" PointerReleased="PreviewReleased" PointerCaptureLost="PreviewCaptureLost" />
                        <TextBlock x:Name="PreviewMessage" Text="Open a folder or a DDS file to begin" Foreground="#D5DDD8"
                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="32" IsHitTestVisible="False" />
                        <Border x:Name="PreviewModeBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,5"
                                Background="#A94432" CornerRadius="3" IsVisible="False" IsHitTestVisible="False">
                            <TextBlock Text="ORIGINAL" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" Margin="2,8,2,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="#404A45" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="220,220,*,*" RowDefinitions="Auto,*">
                <TextBlock Grid.ColumnSpan="4" Text="RECOLOR PARAMETERS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,8" />
                <StackPanel Grid.Row="1" Margin="0,0,10,0" Spacing="4">
                    <TextBlock Text="Source color" FontSize="12" FontWeight="SemiBold" />
                    <ColorPicker x:Name="SourcePicker" Color="#8B5A2B" IsAlphaEnabled="False" Height="178" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Spacing="4">
                    <TextBlock Text="Target color" FontSize="12" FontWeight="SemiBold" />
                    <ColorPicker x:Name="TargetPicker" Color="#C0C0C0" IsAlphaEnabled="False" Height="178" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,*" RowDefinitions="*,*,*" ColumnSpacing="18" RowSpacing="4">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="Intensity (0 or more)" FontSize="12" FontWeight="SemiBold" />
                        <TextBox x:Name="IntensityBox" Text="1" Width="110" HorizontalAlignment="Left" TextChanged="OptionsTextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Hue tolerance" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="ToleranceValue" Grid.Column="1" Text="60°" FontSize="12" />
                        </Grid>
                        <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="360" Value="60" ValueChanged="SliderValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Saturation strength" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="SaturationValue" Grid.Column="1" Text="1.00" FontSize="12" />
                        </Grid>
                        <Slider x:Name="SaturationSlider" Minimum="0" Maximum="1" Value="1" ValueChanged="SliderValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Brightness strength" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="BrightnessValue" Grid.Column="1" Text="1.00" FontSize="12" />
                        </Grid>
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="1" ValueChanged="SliderValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <CheckBox x:Name="RetainSaturationCheckBox" Content="Retain saturation" Click="RetainSettingChanged" />
                        <CheckBox x:Name="RetainBrightnessCheckBox" Content="Retain brightness" Click="RetainSettingChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Alpha mode" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox x:Name="AlphaModeComboBox" SelectedIndex="0" SelectionChanged="AlphaModeChanged" Width="170" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Straight" />
                            <ComboBoxItem Content="Premultiplied" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="3" Margin="18,0,0,0" RowDefinitions="Auto,*">
                    <TextBlock Text="CLI PARAMETER FRAGMENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="ParameterTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="60" />
                    <Button x:Name="CopyParametersButton" Grid.Row="1" Content="Copy" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Padding="12,6" Click="CopyParametersClicked" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#202B29" Padding="14,7">
            <TextBlock Text="SUPPORTED PREVIEW FORMATS   BC1  /  BC2  /  BC3" FontSize="11" Foreground="#C5D0CA" />
        </Border>
    </Grid>
</Window>
